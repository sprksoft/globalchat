{% extends "base" %}

<!-- vim: set ft=html: -->
{% block title %}
Global Chat Admin
{% endblock title %}

{% block head %}

<style type="text/css">
{{theme_css}}
</style>

<link rel="stylesheet" href="{{ url(path="/static/admin.css") }}" />
{% endblock head %}

{% block content %}

<dialog id="savedialog">

</dialog>

<template id="rule-template">
    <div class="rule">
      <div class="top-row">
        <div data-lang="tokengroup" class="rule-input" type="text"></div>
      </div>
      <div class="bot-row">
        <div class="rule-options">
          {% for flag in flagsinfo %}
          <div class="rule-option" data-flagname="{{ flag.0 }}" title="{{ flag.2 }}" onclick="if (this.classList.contains('checked')){ this.classList.remove('checked'); }else{ this.classList.add('checked'); }">{{ flag.0 }}</div>
          {% endfor %}
        </div>
        <button class="pillbtn dangerbtn rule-del">Delete rule</button>
      </div>
      <div class="errors">
      </div>
    </div>
</template>

<template id="replace-rule-template">
  <div class="rule">
    <div class="top-row">
        <div data-lang="none" class="match-input rule-input char-rule-input" type="text"></div>
        <span class="replace-arrow">=&gt;</span>
        <div data-lang="tokengroup" class="replace-input rule-input" type="text"></div>
    </div>
    <div class="bot-row">
      <button class="pillbtn dangerbtn rule-del">Delete rule</button>
    </div>
    <div class="errors">
    </div>
  </div>
</template>

<header>
  <h1>Profanity filter</h1>
  <div class="header-btns">
    <button class="dangerbtn pillbtn" id="save-btn">Revert all</button>
    <button class="pillbtn" id="save-btn">Save all</button>
  </div>
</header>
<main>
  <h2>Replace Rules</h2>
  <div id="replace-rules-list">

  </div>
  <button class="pillbtn" id="replace-rule-add-btn">Add rule</button>
  <h2>Match Rules</h2>
  <div id="rules-list">
  </div>
  <button class="pillbtn" id="rule-add-btn">Add rule</button>

</main>

{% endblock content %}

{% block scripts %}
<script id="jsonRules" type="application/json">
  {{ rules | json_encode | safe }}
</script>
<script id="tokenInfo" type="application/json">
  {{ tokeninfo | json_encode | safe }}
</script>
<script defer type="text/javascript" src="{{ url(path="/static/admin.js") }}"></script>
{% endblock scripts %}
