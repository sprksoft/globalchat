{% extends "base" %}
<!-- vim: set ft=html: -->

{% macro ruleBase(rule_flags) %}
<div class="bot-row">
  {% if rule_flags %}
  <div class="rule-options">
    {% for flag in flagsinfo %}
    <button class="rule-option" data-flagname="{{ flag.0 }}" title="{{ flag.2 }}" onclick="if (this.classList.contains('checked')){ this.classList.remove('checked'); }else{ this.classList.add('checked'); }">{{ flag.0 }}</button>
    {% endfor %}
  </div>
  {% endif %}
  <div class="rule-buttons">
    <button class="pillbtn dangerbtn rule-del-btn" disabled>Delete rule</button>
    <button class="pillbtn rule-disable-toggle">Disable rule</button>
  </div>
</div>
<div class="lints">
</div>
{% endmacro ruleBase %}

{% block title %}
Global Chat Admin
{% endblock title %}

{% block head %}

<style type="text/css">
{{theme_css}}
</style>

<link rel="stylesheet" href="{{ url(path="/static/admin.css") }}" />
{% endblock head %}

{% block content %}

<dialog id="loading-dialog" class="loading-dialog">
  <span>loading</span>
</dialog>

<dialog id="error-dialog">
  <h1 class="center-title">Failed to check rules</h1>
  <p id="error-message"></p>
  <button class="pillbtn" onclick="document.getElementById('error-dialog').close()">Ok</button>
</dialog>

<dialog id="save-dialog">
  <h1 class="center-title">Check completed</h1>
  <div class="lint-section layered-section">
    <h2>Lints</h2>
    <div id="lints"></div>
  </div>
  <div class="flex-row">
    <button autofocus id="ok-btn" class="pillbtn">Continue editing</button>
    <button id="publish-btn" style="margin-left:auto" class="pillbtn dangerbtn">Publish changes</button>
  </div>
</dialog>

<template id="rule-template">
  <div class="rule">
    <div class="top-row">
      <div data-lang="tokengroup" class="rule-input" type="text"></div>
    </div>
    {{ self::ruleBase(rule_flags=true) }}
  </div>
</template>

<template id="replace-rule-template">
  <div class="rule">
    <div class="top-row">
        <div data-lang="none" class="match-input rule-input char-rule-input" type="text"></div>
        <span class="replace-arrow">=&gt;</span>
        <div data-lang="tokengroup" class="replace-input rule-input" type="text"></div>
    </div>
    {{ self::ruleBase(rule_flags=false) }}
  </div>
</template>

<header>
  <h1>Profanity filter</h1>
  <div class="header-btns">
    <button class="dangerbtn pillbtn" id="revert-btn">Revert all</button>
    <button class="pillbtn" id="save-btn">Check rules</button>
  </div>
</header>
<main>
  <h2>Replace Rules</h2>
  <div id="replace-rules-list">

  </div>
  <button class="pillbtn" id="replace-rule-add-btn">Add rule</button>
  <h2>Match Rules</h2>
  <div id="rules-list">
  </div>
  <button class="pillbtn" id="rule-add-btn">Add rule</button>

</main>

{% endblock content %}

{% block scripts %}
<script id="jsonRules" type="application/json">
  {{ rules | json_encode | safe }}
</script>
<script id="jsonLints" type="application/json">
  {{ lints | json_encode | safe }}
</script>
<script id="tokenInfo" type="application/json">
  {{ tokeninfo | json_encode | safe }}
</script>
<script defer type="text/javascript" src="{{ url(path="/static/admin.js") }}"></script>
{% endblock scripts %}
