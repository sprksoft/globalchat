<!-- vim: set ft=html: -->

{{set }}

<dialog id="login">
    {{> svg/gclogo class="logo" }}
    <h3 class="warning">⚠️ Disclaimer ⚠️</h3>
    <ul>
      <li>Iedereen kan een <b class="text-accent">WILLEKEURIGE NAAM</b> kiezen.</li>
      <li>Deze chat wordt <b class="text-accent">NIET GEMODEREERD</b>.</li>
      <li>Deel <b class="text-accent">GEEN GEVOELIGE GEGEVENS</b> met anderen!</li>
    </ul>

    <span id="err-mesg" class="err"></span>
    <div class="container">
      <input maxlength="{{max_username_len}}" id="name-input" type="text" placeholder="({{placeholder}})" data-default_username="{{placeholder}}">
      <button id="connectbtn" class="button">
        {{> svg/arrow }}
      </button>
    </div>
</dialog>

<dialog id="connection-status">
  <span>connecting</span>
</dialog>

<header id="topbar">
  <button id="leavebtn" class="button">
    {{> svg/arrow transform="scale(-1,1)" }}
  </button>

  <h2 class="chat-name">Global chat</h2>
</header>
<div id="mesgs"></div>
<div class="bottom">
  <div id="botbar">
    <div id="send-input" contenteditable enterkeyhint="send" placeholder="Enter a message"></div> <!--Er is denk ik geen goede manier om textareas niet raar te laten zijn dus we moeten hier wel een div gebruiken :(-->
    <button id="sendbtn" class="button">
      <svg
          width="20"
          height="20"
          viewBox="0 0 5.2916666 5.2916666"
          version="1.1">
        <path
            style="fill:currentColor;stroke:currentColor;stroke-width:0.529167;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:none;stroke-opacity:1"
            d="M 4.7624998,2.6458335 0.52916665,0.52916671 1.0583333,2.1166668 3.9687498,2.6458335 1.0583333,3.1750002 0.52916665,4.7625003 Z"/>
      </svg>
    </button>
  </div>
</div>
